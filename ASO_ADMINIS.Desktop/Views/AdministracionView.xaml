<UserControl x:Class="ASO_ADMINIS.Desktop.Views.AdministracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0" Titulo="Administración"
                         Descripcion="Los usuarios con sus permisos, y los datos de la propia organización." />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton Content="Usuarios" GroupName="AdminAcceso"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsUsuarios, Mode=TwoWay}" />
      <RadioButton Content="Organización" GroupName="AdminAcceso"
                   Style="{StaticResource SegmentedTabStyle}"
                   IsChecked="{Binding EsOrganizacion, Mode=TwoWay}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource TabStripStyle}" VerticalAlignment="Bottom" />

    <!-- Ficha de la organización instalada: no es un padron, es la unica fila -->
    <ScrollViewer Grid.Row="2" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding MostrarOrganizacion, Converter={StaticResource BoolToVis}}">
    <WrapPanel DataContext="{Binding Organizacion}" Orientation="Horizontal">
      <Border Style="{StaticResource CardStyle}"
              VerticalAlignment="Top" HorizontalAlignment="Left" Width="460" Margin="0,0,16,16">
        <StackPanel>
          <TextBlock Text="Datos de la organización" FontSize="{StaticResource FsTitle}" FontWeight="{StaticResource FwBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Una instalación atiende a una sola organización."
                     FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,8" />

          <TextBlock Text="Nombre" Style="{StaticResource FormLabelStyle}" />
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   IsEnabled="{Binding PuedeEditar}"
                   Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Text="Código interno" Style="{StaticResource FormLabelStyle}" />
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   IsEnabled="{Binding PuedeEditar}"
                   Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" />

          <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding GuardarCommand}" />

          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,16" />

          <TextBlock Text="Tasa de cambio" FontSize="{StaticResource FsSubtitle}" FontWeight="{StaticResource FwBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Bolívares por dólar, oficial BCV. Se trae sola al iniciar sesión; usa &quot;Actualizar&quot; si hace falta forzarla."
                     FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,8" />

          <TextBlock Text="{Binding TasaActualTexto}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

          <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                  HorizontalAlignment="Left" Margin="0"
                  Command="{Binding ActualizarTasaCommand}" />
        </StackPanel>
      </Border>

      <!-- Datos fiscales del emisor: figuran en cada documento fiscal. Se guardan con el mismo
           botón Guardar de la ficha de la organización. -->
      <Border Style="{StaticResource CardStyle}"
              VerticalAlignment="Top" HorizontalAlignment="Left" Width="520" Margin="0,0,16,16">
        <StackPanel IsEnabled="{Binding PuedeEditar}">
          <TextBlock Text="Datos fiscales" FontSize="{StaticResource FsTitle}" FontWeight="{StaticResource FwBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Figuran en cada factura y nota. Los porcentajes deben coincidir con los programados en el emisor fiscal."
                     FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,8" />

          <controls:FormField Etiqueta="Razón social">
            <TextBox Style="{StaticResource FormTextBoxStyle}"
                     Text="{Binding RazonSocial, UpdateSourceTrigger=PropertyChanged}" />
          </controls:FormField>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:FormField Grid.Column="0" Etiqueta="RIF" Ayuda="{Binding RifAyuda}">
              <TextBox Style="{StaticResource FormTextBoxStyle}"
                       Text="{Binding Rif, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>
            <controls:FormField Grid.Column="2" Etiqueta="Teléfono">
              <TextBox Style="{StaticResource FormTextBoxStyle}"
                       Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>
          </Grid>

          <controls:FormField Etiqueta="Dirección fiscal">
            <TextBox Style="{StaticResource FormTextBoxStyle}"
                     AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Text="{Binding DireccionFiscal, UpdateSourceTrigger=PropertyChanged}" />
          </controls:FormField>

          <CheckBox Content="Contribuyente especial" Margin="0,16,0,0" Cursor="Hand"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    IsChecked="{Binding ContribuyenteEspecial}" />
          <TextBlock Text="Si está marcado, se percibe el IGTF sobre lo cobrado en divisas y el libro de ventas se lleva por quincena."
                     FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />

          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:FormField Grid.Column="0" Etiqueta="IVA general %">
              <TextBox Style="{StaticResource FormTextBoxStyle}"
                       Text="{Binding IvaGeneral, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>
            <controls:FormField Grid.Column="2" Etiqueta="IVA reducida %">
              <TextBox Style="{StaticResource FormTextBoxStyle}"
                       Text="{Binding IvaReducida, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>
            <controls:FormField Grid.Column="4" Etiqueta="IVA adicional %">
              <TextBox Style="{StaticResource FormTextBoxStyle}"
                       ToolTip="General + adicional de bienes suntuarios, ya sumados."
                       Text="{Binding IvaAdicional, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>
            <controls:FormField Grid.Column="6" Etiqueta="IGTF %">
              <TextBox Style="{StaticResource FormTextBoxStyle}"
                       Text="{Binding Igtf, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>
          </Grid>

          <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0"
                  HorizontalAlignment="Left" Command="{Binding GuardarCommand}" />
        </StackPanel>
      </Border>
    </WrapPanel>
    </ScrollViewer>

    <!-- Usuarios y sus permisos: maestro-detalle, se ve a quien se esta editando todo el tiempo -->
    <Grid Grid.Row="2" Margin="0,24,0,0" Visibility="{Binding MostrarUsuarios, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Padron de usuarios -->
      <Grid Grid.Column="0" DataContext="{Binding Usuarios}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" VerticalAlignment="Center">
              <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Texto="{Binding TextoBusqueda, Mode=TwoWay}" />
            </WrapPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Nuevo" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AgregarCommand}" />
              <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding EditarCommand}" />
              <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                      Foreground="{DynamicResource DangerTextBrush}"
                      Command="{Binding EliminarCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
          <Grid>
            <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem}">
              <DataGrid.Columns>
                <controls:ColumnaTexto Header="Usuario" Binding="{Binding NombreUsuario}" Width="30*" MinWidth="160" />
                <controls:ColumnaTexto Header="Rol" Binding="{Binding RolTexto}" Width="14*" MinWidth="100" />
                <controls:ColumnaTexto Header="Estado" Binding="{Binding EstadoTexto}" Width="90" />
              </DataGrid.Columns>
            </DataGrid>

            <controls:EmptyState Icono="{x:Static controls:Iconos.Usuarios}"
                                 Titulo="No hay usuarios que mostrar"
                                 Detalle="Cambia la búsqueda, o crea el primer usuario de la organización."
                                 Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Permisos del usuario seleccionado -->
      <Border Grid.Column="2" Style="{StaticResource CardStyle}"
              DataContext="{Binding PermisosDeUsuario}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Sin usuario seleccionado no hay nada que mostrar -->
          <TextBlock Grid.Row="0" Grid.RowSpan="3"
                     Text="Selecciona un usuario para ver y ajustar sus permisos."
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource FsSubtitle}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HayUsuario}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <StackPanel Grid.Row="0" Margin="0,0,0,8"
                      Visibility="{Binding HayUsuario, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Encabezado}" FontSize="{StaticResource FsTitle}" FontWeight="{StaticResource FwBold}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Marcado = lo puede hacer. Lo que se aparta de su rol queda señalado como concedido o revocado."
                       FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding NotaBloqueo}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"
                       Visibility="{Binding HayBloqueo, Converter={StaticResource BoolToVis}}" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HayUsuario, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding FilasView}">
              <ItemsControl.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBody}" FontWeight="{StaticResource FwBold}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Margin="0,12,0,4" />
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ItemsControl.GroupStyle>

              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,4,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Cursor="Hand"
                              Content="{Binding Etiqueta}"
                              IsChecked="{Binding Concedido}"
                              IsEnabled="{Binding Editable}"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                      <CheckBox.ToolTip>
                        <TextBlock>
                          <Run Text="{Binding Permiso, Mode=OneWay}" />
                          <LineBreak />
                          <Run Text="{Binding MotivoBloqueo, Mode=OneWay}" />
                        </TextBlock>
                      </CheckBox.ToolTip>
                    </CheckBox>

                    <TextBlock Grid.Column="1" Text="{Binding OrigenTexto}" FontSize="{StaticResource FsMicro}"
                               VerticalAlignment="Center" Margin="8,0,4,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Margin="0,12,0,0"
                      Visibility="{Binding HayUsuario, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding NotaVigencia}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
            <Button Content="Guardar permisos" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding GuardarCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
