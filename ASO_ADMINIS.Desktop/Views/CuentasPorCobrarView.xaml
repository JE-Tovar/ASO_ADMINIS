<UserControl x:Class="ASO_ADMINIS.Desktop.Views.CuentasPorCobrarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="1100">
  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <controls:PageHeader Grid.Row="0" Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />
    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}" Margin="0,16,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Row="0" Grid.Column="0">
          <controls:SearchBox Width="280" Margin="0,0,12,0"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />
          <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                   Command="{Binding CambiarFiltroEstadoCommand}">
            <ComboBoxItem Content="Todas" />
            <ComboBoxItem Content="Pendientes" />
            <ComboBoxItem Content="Vencidas" />
            <ComboBoxItem Content="Cobradas" />
            <ComboBoxItem Content="Saldo a favor" />
          </controls:FiltroDropdown>
        </WrapPanel>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ResumenDeuda}" TextWrapping="Wrap"
                   MaxWidth="480" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="Registrar cobro" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding RegistrarCobroCommand}" />
          <Button Content="Estado de cuenta" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding AbrirCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
      <Grid>
        <DataGrid x:Name="TablaCuentas" controls:DobleClicFila.Comando="{Binding AbrirCommand}"
                  Style="{StaticResource DataGridStyle}" ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Factura" Binding="{Binding NumeroFactura}" Width="12*" MinWidth="90" />
            <controls:ColumnaTexto Header="Cliente" Binding="{Binding ClienteTexto}" Width="25*" MinWidth="180" />
            <controls:ColumnaTexto Header="Emisión" Binding="{Binding EmisionTexto}" Width="10*" MinWidth="82" />
            <controls:ColumnaTexto Header="Vencimiento" Binding="{Binding VencimientoTexto}" Width="11*" MinWidth="90" />
            <controls:ColumnaNumero Header="Total Bs" Binding="{Binding TotalTexto}" Width="11*" MinWidth="90" />
            <controls:ColumnaNumero Header="Saldo Bs" Binding="{Binding SaldoTexto}" Width="11*" MinWidth="90" />
            <controls:ColumnaNumero Header="Ref. US$" Binding="{Binding SaldoUsdTexto}" Width="10*" MinWidth="80" />
            <DataGridTemplateColumn Header="Estado" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipEstadoCuentaPorCobrarStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <controls:EmptyState Icono="{x:Static controls:Iconos.CuentasPorPagar}"
                             Titulo="No hay cuentas por cobrar"
                             Detalle="Al emitir una factura a crédito desde Ventas, su saldo aparecerá aquí."
                             Visibility="{Binding HasItems, ElementName=TablaCuentas, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
