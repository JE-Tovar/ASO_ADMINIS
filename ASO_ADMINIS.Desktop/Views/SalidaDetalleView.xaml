<UserControl x:Class="ASO_ADMINIS.Desktop.Views.SalidaDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1000">

  <!-- Ficha de solo lectura de un boleto de salida (doble clic en Inventario · Salidas). Misma
       distribución que su editor: cabecera arriba, renglones con el resto del alto. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <Border DataContext="{Binding Documento}" Style="{StaticResource ChipEstadoSalidaStyle}"
              HorizontalAlignment="Left">
        <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
      </Border>

      <UniformGrid Columns="3" Margin="0,4,0,0">
        <controls:Dato Etiqueta="Fecha" Valor="{Binding Documento.FechaTexto}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Destino" Valor="{Binding Documento.DestinoTexto}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Motivo" Valor="{Binding Documento.MotivoTexto}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Retira" Valor="{Binding Documento.RetiradoPor}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Autoriza" Valor="{Binding Documento.AutorizadoPorNombre}" Margin="0,0,16,0" />
      </UniformGrid>

      <TextBlock Text="Artículos que salieron" Style="{StaticResource CardTitleStyle}" Margin="0,20,0,8" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0" MinHeight="140">
      <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Documento.Lineas}"
                IsReadOnly="True" VerticalAlignment="Top" HeadersVisibility="Column">
        <DataGrid.Columns>
          <controls:ColumnaTexto Header="Código" Binding="{Binding ArticuloCodigo}" Width="12*" MinWidth="90" />
          <controls:ColumnaTexto Header="Descripción" Binding="{Binding ArticuloNombre}" Width="34*" MinWidth="180" />
          <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="14*" MinWidth="100" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <StackPanel Grid.Row="2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <TextBlock Text="Unidades" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding TotalUnidadesTexto}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>

      <controls:Dato Etiqueta="Observaciones" Valor="{Binding Documento.Observaciones}" />
      <controls:Dato Etiqueta="Anulación" Valor="{Binding AnulacionTexto}" />
    </StackPanel>
  </Grid>
</UserControl>
