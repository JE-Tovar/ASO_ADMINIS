<UserControl x:Class="ASO_ADMINIS.Desktop.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroCommand}">
              <ComboBoxItem Content="Todos" />
              <ComboBoxItem Content="Facturas" />
              <ComboBoxItem Content="Notas de crédito" />
              <ComboBoxItem Content="Notas de débito" />
              <ComboBoxItem Content="Por transmitir" />
              <ComboBoxItem Content="Histórico" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="{Binding Resumen}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Emitir factura" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Nota de crédito" Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Devolución total o parcial de la factura seleccionada"
                    Command="{Binding NotaCreditoCommand}" />
            <Button Content="Nota de débito" Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Cargo adicional sobre la factura seleccionada"
                    Command="{Binding NotaDebitoCommand}" />
            <Button Content="Transmitir pendientes" Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Envía al emisor fiscal los documentos hechos en papel de contingencia"
                    Command="{Binding TransmitirCommand}" />
            <TextBlock Text="{Binding PendientesTexto}" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource WarningTextBrush}" />
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                     Text="{Binding EmisorTexto}" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaVentas" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Tipo" Binding="{Binding TipoCorto}" Width="6*" MinWidth="44" />
              <controls:ColumnaTexto Header="N° fiscal" Binding="{Binding NumeroFiscalTexto}" Width="11*" MinWidth="90" />
              <controls:ColumnaTexto Header="Control" Binding="{Binding NumeroControl}" Width="11*" MinWidth="86" />
              <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaHoraTexto}" Width="12*" MinWidth="104" />
              <controls:ColumnaTexto Header="Cliente" Binding="{Binding ClienteTexto}" Width="20*" MinWidth="130" />
              <controls:ColumnaTexto Header="Artículos" Binding="{Binding ArticuloTexto}" Width="20*" MinWidth="130" />
              <controls:ColumnaTexto Header="Pago" Binding="{Binding MetodoPagoTexto}" Width="12*" MinWidth="90" />
              <controls:ColumnaNumero Header="Total Bs" Binding="{Binding TotalBsTexto}" Width="12*" MinWidth="90" />
              <controls:ColumnaNumero Header="Ref. US$" Binding="{Binding TotalUsdTexto}" Width="9*" MinWidth="70" />
              <DataGridTemplateColumn Header="Estado" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoVentaStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Ventas}"
                               Titulo="No hay documentos"
                               Detalle="Emite la primera factura de un artículo con existencia en el almacén."
                               Visibility="{Binding HasItems, ElementName=TablaVentas, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
