<UserControl x:Class="ASO_ADMINIS.Desktop.Views.LibroVentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}" Margin="0,16,0,0">
      <StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <ComboBox Width="100" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,8,0"
                    ItemsSource="{Binding Anios}" SelectedItem="{Binding Anio}" />
          <ComboBox Width="140" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,8,0"
                    ItemsSource="{Binding Meses}" SelectedIndex="{Binding MesIndice}" />
          <ComboBox Width="190" Style="{StaticResource FormComboBoxStyle}" Margin="0,0,16,0"
                    ItemsSource="{Binding Quincenas}" SelectedItem="{Binding Quincena}" />
          <Button Content="Exportar a CSV" Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                  Command="{Binding ExportarCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding ResumenTexto}" Margin="0,12,0,0" FontWeight="{StaticResource FwBold}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding PeriodoAyuda}" Margin="0,4,0,0"
                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0" Margin="0,16,0,0">
      <Grid>
        <!-- Libro ancho a propósito: son las columnas que pide el SENIAT. Se desplaza en horizontal. -->
        <DataGrid x:Name="TablaLibro" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Filas}"
                  IsReadOnly="True" HorizontalScrollBarVisibility="Auto" FrozenColumnCount="2">
          <DataGrid.Columns>
            <controls:ColumnaNumero Header="N° Op." Binding="{Binding Operacion}" Width="56" />
            <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaTexto}" Width="96" />
            <controls:ColumnaTexto Header="RIF / C.I." Binding="{Binding RifCliente}" Width="110" />
            <controls:ColumnaTexto Header="Nombre o razón social" Binding="{Binding NombreCliente}" Width="220" />
            <controls:ColumnaTexto Header="Tipo" Binding="{Binding TipoDocumento}" Width="48" />
            <controls:ColumnaTexto Header="Transacción" Binding="{Binding TipoTransaccion}" Width="90" />
            <controls:ColumnaTexto Header="N° Factura" Binding="{Binding NumeroFactura}" Width="170" />
            <controls:ColumnaTexto Header="N° Control" Binding="{Binding NumeroControl}" Width="110" />
            <controls:ColumnaTexto Header="N° Nota D/C" Binding="{Binding NumeroNota}" Width="110" />
            <controls:ColumnaTexto Header="Factura afectada" Binding="{Binding NumeroFacturaAfectada}" Width="110" />
            <controls:ColumnaTexto Header="Serial / Z" Binding="{Binding SerialZ}" Width="130" />
            <controls:ColumnaNumero Header="Total con IVA" Binding="{Binding TotalConIva, StringFormat=N2}" Width="110" />
            <controls:ColumnaNumero Header="Exentas" Binding="{Binding Exento, StringFormat=N2}" Width="100" />
            <controls:ColumnaNumero Header="BI general" Binding="{Binding BaseGeneral, StringFormat=N2}" Width="110" />
            <controls:ColumnaNumero Header="%" Binding="{Binding PorcentajeGeneral, StringFormat=0.##}" Width="44" />
            <controls:ColumnaNumero Header="IVA general" Binding="{Binding IvaGeneral, StringFormat=N2}" Width="100" />
            <controls:ColumnaNumero Header="BI reducida" Binding="{Binding BaseReducida, StringFormat=N2}" Width="100" />
            <controls:ColumnaNumero Header="%" Binding="{Binding PorcentajeReducida, StringFormat=0.##}" Width="44" />
            <controls:ColumnaNumero Header="IVA reducida" Binding="{Binding IvaReducida, StringFormat=N2}" Width="100" />
            <controls:ColumnaNumero Header="BI adicional" Binding="{Binding BaseAdicional, StringFormat=N2}" Width="100" />
            <controls:ColumnaNumero Header="%" Binding="{Binding PorcentajeAdicional, StringFormat=0.##}" Width="44" />
            <controls:ColumnaNumero Header="IVA adicional" Binding="{Binding IvaAdicional, StringFormat=N2}" Width="100" />
            <controls:ColumnaNumero Header="IGTF" Binding="{Binding Igtf, StringFormat=N2}" Width="90" />
            <controls:ColumnaNumero Header="IVA retenido" Binding="{Binding IvaRetenido, StringFormat=N2}" Width="100" />
            <controls:ColumnaTexto Header="Comprobante ret." Binding="{Binding ComprobanteRetencion}" Width="140" />
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="{x:Static controls:Iconos.Reportes}"
                             Titulo="Sin operaciones en el período"
                             Detalle="El libro se llena con las facturas y notas emitidas en Ventas · Registro."
                             Visibility="{Binding HasItems, ElementName=TablaLibro, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
