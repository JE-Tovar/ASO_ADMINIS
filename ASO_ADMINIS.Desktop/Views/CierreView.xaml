<UserControl x:Class="ASO_ADMINIS.Desktop.Views.CierreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <!-- Turno de la caja de la sesión: sin turno propio abierto no se factura -->
    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Mi turno" Style="{StaticResource CardTitleStyle}" />
          <TextBlock Text="{Binding TurnoTexto}" FontSize="{StaticResource FsSubtitle}" FontWeight="{StaticResource FwBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding TurnoDetalle}" FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Abrir turno" Style="{StaticResource PrimaryButtonStyle}"
                  ToolTip="Abre tu turno en tu caja, con el fondo de la gaveta"
                  Command="{Binding AbrirTurnoCommand}" />
          <Button Content="Cerrar turno" Style="{StaticResource SecondaryButtonStyle}"
                  ToolTip="Arqueo: cuenta el efectivo y lo compara con lo esperado"
                  Command="{Binding CerrarTurnoCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource ToolbarStyle}" Margin="0,16,0,0">
      <StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="Día" VerticalAlignment="Center" Margin="0,0,8,0"
                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
          <DatePicker Width="140" VerticalAlignment="Center" Style="{StaticResource FormDatePickerStyle}"
                      SelectedDate="{Binding Dia}" />
          <TextBlock Text="{Binding DocumentosTexto}" VerticalAlignment="Center" Margin="16,0,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="Reporte X" Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                  ToolTip="Lectura de la máquina fiscal sin cerrar el día"
                  Command="{Binding ReporteXCommand}" />
          <Button Content="Cierre Z" Style="{StaticResource PrimaryButtonStyle}"
                  ToolTip="Cierra el día en la máquina fiscal"
                  Command="{Binding CierreZCommand}" />
          <Button Content="Probar emisor" Style="{StaticResource SecondaryButtonStyle}"
                  ToolTip="Comprueba que el emisor fiscal de esta PC responde, sin emitir nada"
                  Command="{Binding ProbarEmisorCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding EmisorTexto}" Margin="0,8,0,0" TextWrapping="Wrap"
                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1.6*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{Binding ResumenTitulo}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />
          <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Resumen}" IsReadOnly="True"
                    HeadersVisibility="None">
            <DataGrid.Columns>
              <controls:ColumnaTexto Binding="{Binding Concepto}" Width="60*" />
              <controls:ColumnaNumero Binding="{Binding Valor}" Width="40*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Por medio de pago (Bs)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />
          <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding PorMetodo}" IsReadOnly="True"
                    HeadersVisibility="None">
            <DataGrid.Columns>
              <controls:ColumnaTexto Binding="{Binding Concepto}" Width="45*" />
              <controls:ColumnaNumero Binding="{Binding Valor}" Width="55*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="16" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="0" VerticalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Reportes Z" Style="{StaticResource CardTitleStyle}" Margin="16,16,16,8" />
          <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Historial}" IsReadOnly="True">
            <DataGrid.Columns>
              <controls:ColumnaNumero Header="Z" Binding="{Binding NumeroZ}" Width="8*" MinWidth="40" />
              <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaTexto}" Width="20*" MinWidth="124" />
              <controls:ColumnaTexto Header="Caja" Binding="{Binding CajaCodigo}" Width="12*" MinWidth="84" />
              <controls:ColumnaNumero Header="Máquina Bs" Binding="{Binding TotalTexto}" Width="16*" MinWidth="90" />
              <controls:ColumnaNumero Header="Sistema Bs" Binding="{Binding TotalSistemaTexto}" Width="16*" MinWidth="90" />
              <controls:ColumnaTexto Header="" Binding="{Binding CuadraTexto}" Width="16*" MinWidth="90" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Turnos: los de la caja propia o, para quien supervisa, los de todas -->
      <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0" VerticalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="16,12,16,8">
            <TextBlock Text="Turnos" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
            <Button Content="Cerrar turno de otro cajero" Style="{StaticResource SecondaryButtonStyle}" Margin="0"
                    HorizontalAlignment="Right"
                    ToolTip="Cerrar un turno que otro cajero dejó abierto. Supervisor o administración."
                    Visibility="{Binding PuedeCerrarAjenos, Converter={StaticResource BoolToVis}}"
                    Command="{Binding CerrarSeleccionadoCommand}" />
          </Grid>
          <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Turnos}" IsReadOnly="True"
                    SelectedItem="{Binding TurnoSeleccionado}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Caja" Binding="{Binding CajaCodigo}" Width="12*" MinWidth="72" />
              <controls:ColumnaTexto Header="Cajero" Binding="{Binding UsuarioNombre}" Width="20*" MinWidth="110" />
              <controls:ColumnaTexto Header="Apertura" Binding="{Binding AperturaTexto}" Width="18*" MinWidth="110" />
              <controls:ColumnaTexto Header="Cierre" Binding="{Binding CierreTexto}" Width="18*" MinWidth="110" />
              <controls:ColumnaTexto Header="Estado" Binding="{Binding EstadoTexto}" Width="10*" MinWidth="70" />
              <controls:ColumnaNumero Header="Diferencia" Binding="{Binding DiferenciaTexto}" Width="16*" MinWidth="90" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
