<UserControl x:Class="ASO_ADMINIS.Desktop.Views.ModeloEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="460">

  <StackPanel>
    <controls:FormField Etiqueta="Marca">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Column="0" Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Marcas}" DisplayMemberPath="Nombre"
                  SelectedItem="{Binding MarcaSeleccionada}" />

        <Button Grid.Column="2" Content="+ Nueva" Style="{StaticResource SecondaryButtonStyle}"
                Margin="0" Command="{Binding NuevaMarcaCommand}" />

        <Button Grid.Column="4" Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                Margin="0" Command="{Binding EditarMarcaCommand}" />
      </Grid>
    </controls:FormField>

    <controls:FormField Etiqueta="Nombre del modelo">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Categoría">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding CategoriasDisponibles}" DisplayMemberPath="Texto"
                    SelectedItem="{Binding CategoriaSeleccionada}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Unidad">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Unidades}"
                    SelectedItem="{Binding UnidadSeleccionada}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Precio de venta (US$)" Ayuda="Referencia; todavía no hay módulo de Ventas que lo use.">
      <StackPanel>
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding PrecioVentaBsTexto}" FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
    </controls:FormField>

    <controls:FormField Etiqueta="Notas">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <CheckBox Content="Activo" Margin="0,16,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding Activo}" />

    <TextBlock Text="Un modelo inactivo se conserva en el historial, pero no se ofrece al registrar entradas ni salidas. La existencia se lleva en Inventario · Almacén, no aquí."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
