<UserControl x:Class="ASO_ADMINIS.Desktop.Views.MarcaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="380">

  <StackPanel>
    <controls:FormField Etiqueta="Nombre de la marca">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Notas">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <CheckBox Content="Activo" Margin="0,16,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding Activo}" />

    <TextBlock Text="Una marca inactiva se conserva para el histórico, pero no se ofrece al registrar modelos nuevos."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
