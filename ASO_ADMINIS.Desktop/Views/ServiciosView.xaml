<UserControl x:Class="ASO_ADMINIS.Desktop.Views.ServiciosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}" Margin="0,16,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" VerticalAlignment="Center">
          <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                              Texto="{Binding TextoBusqueda, Mode=TwoWay}" />
        </WrapPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
          <Button Content="Nuevo servicio" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding AgregarCommand}" />
          <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding EditarCommand}" />
          <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Command="{Binding EliminarCommand}"
                  ToolTip="Un servicio ya facturado se puede eliminar si está inactivo; sus facturas se conservan." />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0" Margin="0,16,0,0">
      <Grid>
        <DataGrid x:Name="Tabla" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Código" Binding="{Binding Codigo}" Width="12*" MinWidth="88" />
            <controls:ColumnaTexto Header="Descripción" Binding="{Binding Descripcion}" Width="32*" MinWidth="160" />
            <controls:ColumnaTexto Header="Categoría" Binding="{Binding Categoria}" Width="15*" MinWidth="100" />
            <controls:ColumnaTexto Header="IVA" Binding="{Binding AlicuotaTexto}" Width="10*" MinWidth="70" />
            <controls:ColumnaNumero Header="Precio (US$)" Binding="{Binding PrecioVentaTexto}" Width="11*" MinWidth="86" />
            <controls:ColumnaNumero Header="Precio (Bs)" Binding="{Binding PrecioVentaBsTexto}" Width="12*" MinWidth="90" />
            <DataGridTemplateColumn Header="Estado" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ChipActivoStyle}">
                    <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="{x:Static controls:Iconos.Ventas}"
                             Titulo="No hay servicios"
                             Detalle="Da de alta lo que facturas sin sacarlo del almacén, como un cambio de aceite o una recarga de batería, con su precio fijo."
                             Visibility="{Binding HasItems, ElementName=Tabla, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
