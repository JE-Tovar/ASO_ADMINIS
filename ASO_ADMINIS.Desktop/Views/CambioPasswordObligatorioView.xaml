<Window x:Class="ASO_ADMINIS.Desktop.Views.CambioPasswordObligatorioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
        mc:Ignorable="d"
        Title="Cambia tu contraseña — ASO Adminis"
        Icon="pack://application:,,,/Assets/Logo/aso-adminis.ico"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

  <Grid Margin="32">
    <Border Style="{StaticResource SectionCardStyle}">
      <StackPanel>
        <TextBlock Text="Cambia tu contraseña" FontSize="{StaticResource FsTitle}" FontWeight="{StaticResource FwBold}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock x:Name="Explicacion" TextWrapping="Wrap" Margin="0,6,0,0"
                   FontSize="{StaticResource FsBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="La contraseña con la que entraste la puso un administrador. Elige una que solo sepas tú para seguir." />

        <controls:FormField Etiqueta="Contraseña nueva" Requerido="True" x:Name="CampoNueva">
          <PasswordBox x:Name="NuevaBox" Style="{StaticResource FormPasswordBoxStyle}" />
        </controls:FormField>

        <controls:FormField Etiqueta="Repite la contraseña nueva" Requerido="True" x:Name="CampoConfirmacion">
          <PasswordBox x:Name="ConfirmacionBox" Style="{StaticResource FormPasswordBoxStyle}" />
        </controls:FormField>

        <TextBlock x:Name="ErrorTexto" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource DangerTextBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
          <Button Content="Salir" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Click="OnSalir" />
          <Button Content="Cambiar y entrar" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnCambiar" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
