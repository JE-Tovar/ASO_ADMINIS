<UserControl x:Class="ASO_ADMINIS.Desktop.Views.GastoVarioDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="520">

  <!-- Ficha de solo lectura de un gasto vario (doble clic en Finanzas · Gastos varios). -->
  <StackPanel>
    <Border DataContext="{Binding Documento}" Style="{StaticResource ChipEstadoGastoVarioStyle}"
            HorizontalAlignment="Left">
      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
    </Border>

    <UniformGrid Columns="2" Margin="0,4,0,0">
      <controls:Dato Etiqueta="Fecha" Valor="{Binding Documento.FechaTexto}" Margin="0,0,16,0" />
      <controls:Dato Etiqueta="Categoría" Valor="{Binding Documento.Categoria}" Margin="0,0,16,0" />
    </UniformGrid>
    <controls:Dato Etiqueta="Concepto" Valor="{Binding Documento.Concepto}" />
    <UniformGrid Columns="2">
      <controls:Dato Etiqueta="Beneficiario" Valor="{Binding Documento.Beneficiario}" Margin="0,0,16,0" />
      <controls:Dato Etiqueta="Referencia" Valor="{Binding Documento.Referencia}" Margin="0,0,16,0" />
      <controls:Dato Etiqueta="Monto" Valor="{Binding Documento.MontoTexto}" Margin="0,0,16,0" />
      <controls:Dato Etiqueta="Tasa de cambio" Valor="{Binding TasaTexto}" Margin="0,0,16,0" />
      <controls:Dato Etiqueta="Equivalente en Bs" Valor="{Binding Documento.MontoBsTexto}" Margin="0,0,16,0" />
      <controls:Dato Etiqueta="Pagado con" Valor="{Binding Documento.PagoTexto}" Margin="0,0,16,0" />
    </UniformGrid>
    <controls:Dato Etiqueta="Registrado por" Valor="{Binding RegistroTexto}" />
    <controls:Dato Etiqueta="Anulación" Valor="{Binding AnulacionTexto}" />
  </StackPanel>
</UserControl>
