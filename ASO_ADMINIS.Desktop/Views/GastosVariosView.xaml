<UserControl x:Class="ASO_ADMINIS.Desktop.Views.GastosVariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <controls:SearchBox Width="280" Margin="0,0,12,0" VerticalAlignment="Center"
                                Texto="{Binding TextoBusqueda, Mode=TwoWay}" />

            <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                     Command="{Binding CambiarFiltroCommand}">
              <ComboBoxItem Content="Todos" />
              <ComboBoxItem Content="Este mes" />
              <ComboBoxItem Content="En Bs" />
              <ComboBoxItem Content="En US$" />
              <ComboBoxItem Content="Anulados" />
            </controls:FiltroDropdown>
          </WrapPanel>

          <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="{Binding Resumen}" FontSize="{StaticResource FsBody}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />

          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                      Margin="0,12,0,0">
            <Button Content="Registrar gasto" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AgregarCommand}" />
            <Button Content="Anular" Style="{StaticResource SecondaryButtonStyle}"
                    Foreground="{DynamicResource DangerTextBrush}"
                    Command="{Binding AnularCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <DataGrid x:Name="TablaGastosVarios" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Nº" Binding="{Binding Numero}" Width="10*" MinWidth="86" />
              <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaTexto}" Width="9*" MinWidth="78" />
              <controls:ColumnaTexto Header="Categoría" Binding="{Binding Categoria}" Width="14*" MinWidth="110" />
              <controls:ColumnaTexto Header="Concepto" Binding="{Binding Concepto}" Width="22*" MinWidth="140" />
              <controls:ColumnaTexto Header="Beneficiario" Binding="{Binding Beneficiario}" Width="14*" MinWidth="100" />
              <controls:ColumnaTexto Header="Pagado con" Binding="{Binding PagoTexto}" Width="13*" MinWidth="100" />
              <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="11*" MinWidth="90" />
              <controls:ColumnaNumero Header="Bs" Binding="{Binding MontoBsTexto}" Width="11*" MinWidth="90" />
              <DataGridTemplateColumn Header="Estado" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ChipEstadoGastoVarioStyle}">
                      <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <controls:EmptyState Icono="{x:Static controls:Iconos.Finanzas}"
                               Titulo="No hay gastos varios registrados"
                               Detalle="Registra aquí lo que la empresa paga y no es una factura de proveedor: luz, alquiler, fletes, limpieza…"
                               Visibility="{Binding HasItems, ElementName=TablaGastosVarios, Converter={StaticResource SinItemsAVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
