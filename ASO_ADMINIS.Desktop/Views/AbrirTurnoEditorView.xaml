<UserControl x:Class="ASO_ADMINIS.Desktop.Views.AbrirTurnoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="380">

  <StackPanel>
    <TextBlock Text="{Binding Descripcion}" FontSize="{StaticResource FsBody}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondaryBrush}" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:FormField Grid.Column="0" Etiqueta="Fondo en Bs.">
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding FondoBs, UpdateSourceTrigger=PropertyChanged}" />
      </controls:FormField>
      <controls:FormField Grid.Column="2" Etiqueta="Fondo en US$">
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding FondoDivisa, UpdateSourceTrigger=PropertyChanged}" />
      </controls:FormField>
    </Grid>

    <TextBlock Text="Vacío cuenta como cero."
               FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
