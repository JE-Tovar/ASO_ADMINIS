<UserControl x:Class="ASO_ADMINIS.Desktop.Views.CajaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="380">

  <StackPanel>
    <controls:FormField Etiqueta="Código" Ayuda="Figura en cada factura. No se puede cambiar después de crear la caja.">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               IsEnabled="{Binding EsNueva}"
               Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Nombre">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               ToolTip="Cómo la llaman en la tienda: Caja de la entrada, Caja 2"
               Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <CheckBox Content="Activa" Margin="0,16,0,0" Cursor="Hand"
              IsChecked="{Binding Activa}"
              ToolTip="Una caja inactiva no se puede asignar y sus cajeros no pueden entrar; conserva su historial" />

    <TextBlock Text="Cada cajero queda atado a una caja en Administración · Usuarios. Las cajas no se borran: se desactivan."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
