<UserControl x:Class="ASO_ADMINIS.Desktop.Views.UsuarioEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="380">

  <StackPanel>
    <controls:FormField Etiqueta="Nombre de usuario">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Nombre completo">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Rol">
      <ComboBox Style="{StaticResource FormComboBoxStyle}"
                ItemsSource="{Binding RolesDisponibles}"
                SelectedItem="{Binding RolSeleccionado}"
                DisplayMemberPath="Texto" />
    </controls:FormField>

    <controls:FormField Etiqueta="Caja asignada"
                        Ayuda="Obligatoria para un Cajero: es la caja en la que vende, en cualquier PC donde entre.">
      <ComboBox Style="{StaticResource FormComboBoxStyle}"
                ItemsSource="{Binding CajasDisponibles}"
                SelectedItem="{Binding CajaSeleccionada}"
                DisplayMemberPath="Texto" />
    </controls:FormField>

    <controls:FormField Etiqueta="{Binding EtiquetaPassword}" Ayuda="{Binding AyudaPassword}">
      <PasswordBox x:Name="PasswordBox" Padding="8,8" PasswordChanged="OnPasswordChanged" />
    </controls:FormField>

    <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="{StaticResource RadMd}"
            Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBordeBrush}" BorderThickness="1"
            Visibility="{Binding EstaBloqueado, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Text="{Binding BloqueoTexto}" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
        <CheckBox Content="Desbloquear al guardar" Margin="0,6,0,0" Cursor="Hand"
                  Foreground="{DynamicResource WarningTextBrush}"
                  IsChecked="{Binding Desbloquear}" />
      </StackPanel>
    </Border>

    <CheckBox Content="Activo" Margin="0,16,0,0" Cursor="Hand"
              IsChecked="{Binding Activo}" />

    <TextBlock Text="El usuario queda en la organización activa y solo verá los datos de esa organización. La contraseña se guarda cifrada; no se puede consultar después, solo reemplazar."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
