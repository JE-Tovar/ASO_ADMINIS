<UserControl x:Class="ASO_ADMINIS.Desktop.Views.VentaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="720">

  <!--
    Distribución de punto de venta. La ventana abre maximizada (AbreMaximizado) y le da a este
    control su alto completo, así que la grilla de renglones (fila "*") llena la pantalla y lleva
    su propio scroll. A la derecha, un panel de ancho fijo con lo que mira el cajero al cobrar:
    total, estado del cobro, desglose fiscal y pagos.
  -->

  <UserControl.Resources>
    <!-- Las columnas del DataGrid no heredan DataContext; ver Controls/PuenteDeDatos.cs -->
    <controls:PuenteDeDatos x:Key="Puente" Datos="{Binding}" />

    <!-- Filas del desglose: etiqueta a la izquierda, monto a la derecha. -->
    <Style x:Key="DesgloseEtiqueta" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FsBody}" />
    </Style>
    <Style x:Key="DesgloseMonto" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FsBody}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="DesgloseNota" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="{StaticResource FsCaption}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="EncabezadoTarjeta" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="560" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="400" />
    </Grid.ColumnDefinitions>

    <!-- ================================================================ Izquierda -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Contexto: quién emite y a qué tasa. -->
      <WrapPanel Grid.Row="0" Margin="0,0,0,12">
        <Border Style="{StaticResource ChipContextoStyle}">
          <TextBlock Text="{Binding EmisorTexto}" FontSize="{StaticResource FsCaption}" />
        </Border>
        <TextBlock Text="{Binding TasaTexto}" FontSize="{StaticResource FsCaption}" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </WrapPanel>

      <!-- Cliente: la factura pide todos sus datos y, al emitir, lo da de alta o pone al día su
           ficha. El campo RIF/C.I. sugiere de la lista y autocompleta con la identificación exacta. -->
      <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Margin="0,0,0,4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Cliente" Style="{StaticResource EncabezadoTarjeta}" />
            <Border DockPanel.Dock="Left" Style="{StaticResource ChipEstadoClienteStyle}" Margin="12,0,0,0"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding EstadoClienteTexto}" FontSize="{StaticResource FsCaption}" />
            </Border>
            <Button DockPanel.Dock="Right" Content="Consumidor final" Margin="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Vacía los datos: la factura sale a consumidor final"
                    Command="{Binding ConsumidorFinalCommand}" />
          </DockPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.4*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="2.4*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <controls:FormField Grid.Column="0" Etiqueta="RIF, C.I. o nombre" Ayuda="{Binding ClienteRifAyuda}">
              <Grid>
                <TextBox x:Name="CajaRif" Style="{StaticResource FormTextBoxStyle}"
                         Text="{Binding ClienteRif, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="CajaRif_PreviewKeyDown" />

                <!-- Sugerencias del padrón, flotando bajo el campo. -->
                <Popup PlacementTarget="{Binding ElementName=CajaRif}" Placement="Bottom"
                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                       IsOpen="{Binding MostrarSugerencias, Mode=TwoWay}">
                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="{StaticResource RadSm}" Padding="2"
                          Margin="0,4,8,8" MinWidth="420"
                          Effect="{DynamicResource SombraFlotante}">
                    <ListBox x:Name="ListaClientes" MaxHeight="280" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"
                             ItemsSource="{Binding Sugerencias}"
                             SelectedItem="{Binding SugerenciaSeleccionada}"
                             PreviewMouseLeftButtonUp="ListaClientes_PreviewMouseLeftButtonUp">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="Focusable" Value="False" />
                          <Setter Property="Cursor" Value="Hand" />
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="120" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Rif}" FontWeight="{StaticResource FwMedium}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Nombre}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding Telefono}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                </Popup>
              </Grid>
            </controls:FormField>

            <controls:FormField Grid.Column="2" Etiqueta="Nombre o razón social">
              <TextBox Style="{StaticResource FormTextBoxStyle}"
                       Text="{Binding ClienteNombre, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>

            <controls:FormField Grid.Column="4" Etiqueta="Teléfono" Ayuda="Opcional.">
              <TextBox Style="{StaticResource FormTextBoxStyle}" MaxLength="40"
                       Text="{Binding ClienteTelefono, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3.8*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <controls:FormField Grid.Column="0" Etiqueta="Dirección fiscal"
                                Ayuda="Obligatoria si el cliente tiene RIF (la necesita para el crédito fiscal).">
              <TextBox Style="{StaticResource FormTextBoxStyle}" MaxLength="300"
                       Text="{Binding ClienteDireccion, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>

            <controls:FormField Grid.Column="2" Etiqueta="Correo" Ayuda="{Binding ClienteCorreoAyuda}">
              <TextBox Style="{StaticResource FormTextBoxStyle}" MaxLength="120"
                       Text="{Binding ClienteCorreo, UpdateSourceTrigger=PropertyChanged}" />
            </controls:FormField>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Renglones: se estiran hasta abajo, con su propio scroll. -->
      <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Margin="16,12,16,8" Text="Artículos y servicios" Style="{StaticResource EncabezadoTarjeta}" />

          <!-- Se agrega buscando: Enter o clic agrega; si ya está, le suma 1. -->
          <controls:BuscadorArticulos Grid.Row="1" Margin="16,0,16,12" DataContext="{Binding Buscador}" />

          <TextBlock Grid.Row="2" Margin="16,48,16,0" HorizontalAlignment="Center" TextAlignment="Center"
                     Text="Busca un artículo o servicio arriba para agregarlo a la factura."
                     Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" Panel.ZIndex="1"
                     Visibility="{Binding SinLineas, Converter={StaticResource BoolToVis}}" />

          <DataGrid Grid.Row="2" Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding Lineas}"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto"
                    HeadersVisibility="Column" CanUserSortColumns="False">
            <DataGrid.Columns>
              <controls:ColumnaTexto Header="Código" Binding="{Binding ArticuloSeleccionado.Codigo}" Width="12*" MinWidth="96">
                <controls:ColumnaTexto.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </controls:ColumnaTexto.ElementStyle>
              </controls:ColumnaTexto>
              <controls:ColumnaTexto Header="Descripción" Binding="{Binding ArticuloSeleccionado.Descripcion}" Width="30*" MinWidth="180" />

              <DataGridTemplateColumn Header="Presentación" Width="13*" MinWidth="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                              ItemsSource="{Binding Presentaciones}" DisplayMemberPath="Nombre"
                              SelectedItem="{Binding PresentacionSeleccionada, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{Binding PresentacionSeleccionada.Texto}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <controls:ColumnaNumero Header="Existencia" Binding="{Binding ExistenciaTexto}" Width="11*" MinWidth="84" />

              <DataGridTemplateColumn Header="Cantidad" Width="9*" MinWidth="76">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBox TextAlignment="Right" controls:Enfoque.AlCargar="{Binding PideCantidad}"
                         Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource LineaTextBoxStyle}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SePasa}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                              <Setter Property="ToolTip" Value="No hay tanta existencia de este artículo." />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- De solo lectura: el precio es el del catálogo (lo vuelve a fijar VentasService). -->
              <controls:ColumnaNumero Header="Precio US$" Binding="{Binding PrecioUnitario}" Width="10*" MinWidth="84" />

              <controls:ColumnaTexto Header="IVA" Binding="{Binding AlicuotaTexto}" Width="6*" MinWidth="48" />

              <controls:ColumnaNumero Header="Monto Bs" Binding="{Binding MontoTexto}" Width="12*" MinWidth="100">
                <controls:ColumnaNumero.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontWeight" Value="{StaticResource FwMedium}" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </controls:ColumnaNumero.ElementStyle>
              </controls:ColumnaNumero>

              <DataGridTemplateColumn Width="48">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="{x:Static controls:Iconos.Limpiar}"
                            Style="{StaticResource LineaBotonQuitarStyle}" ToolTip="Quitar este renglón"
                            Command="{Binding Datos.QuitarLineaCommand, Source={StaticResource Puente}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- ================================================================ Derecha: cobro -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <!-- Total y estado del cobro -->
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Total a pagar" FontSize="{StaticResource FsCaption}"
                       FontWeight="{StaticResource FwMedium}" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding TotalTexto}" FontSize="{StaticResource FsMetric}"
                       FontWeight="{StaticResource FwBold}" Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding TotalUsdTexto}" FontSize="{StaticResource FsBody}"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Border Style="{StaticResource ChipEstadoCobroStyle}" Margin="0,12,0,0">
              <TextBlock Text="{Binding PendienteTexto}" FontSize="{StaticResource FsBody}"
                         FontWeight="{StaticResource FwMedium}" />
            </Border>
          </StackPanel>
        </Border>

        <!-- Desglose fiscal -->
        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Desglose" Style="{StaticResource EncabezadoTarjeta}" Margin="0,0,0,8" />

            <DockPanel Margin="0,0,0,4" Visibility="{Binding HayExento, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Exento (E)" Style="{StaticResource DesgloseEtiqueta}" />
              <TextBlock Text="{Binding ExentoTexto}" Style="{StaticResource DesgloseMonto}" />
            </DockPanel>

            <DockPanel>
              <TextBlock Text="Base general (G)" Style="{StaticResource DesgloseEtiqueta}" />
              <TextBlock Text="{Binding BaseGeneralTexto}" Style="{StaticResource DesgloseMonto}" />
            </DockPanel>
            <TextBlock Text="{Binding IvaGeneralTexto}" Style="{StaticResource DesgloseNota}" />

            <StackPanel Visibility="{Binding HayReducida, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <TextBlock Text="Base reducida (R)" Style="{StaticResource DesgloseEtiqueta}" />
                <TextBlock Text="{Binding BaseReducidaTexto}" Style="{StaticResource DesgloseMonto}" />
              </DockPanel>
              <TextBlock Text="{Binding IvaReducidaTexto}" Style="{StaticResource DesgloseNota}" />
            </StackPanel>

            <StackPanel Visibility="{Binding HayAdicional, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <TextBlock Text="Base adicional (A)" Style="{StaticResource DesgloseEtiqueta}" />
                <TextBlock Text="{Binding BaseAdicionalTexto}" Style="{StaticResource DesgloseMonto}" />
              </DockPanel>
              <TextBlock Text="{Binding IvaAdicionalTexto}" Style="{StaticResource DesgloseNota}" />
            </StackPanel>

            <TextBlock Text="{Binding IgtfTexto}" Style="{StaticResource DesgloseNota}"
                       Visibility="{Binding HayIgtf, Converter={StaticResource BoolToVis}}" />

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8" />

            <DockPanel>
              <TextBlock Text="Pagado" Style="{StaticResource DesgloseEtiqueta}" />
              <TextBlock Text="{Binding PagadoTexto}" Style="{StaticResource DesgloseMonto}"
                         FontWeight="{StaticResource FwMedium}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Pagos: una mini-tarjeta por pago (la grilla de cinco columnas no cabía en el panel). -->
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="Pagos" Style="{StaticResource EncabezadoTarjeta}" Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Pagos}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource BdFino}"
                          CornerRadius="{StaticResource RadSm}" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Style="{StaticResource FormComboBoxStyle}"
                                  ItemsSource="{Binding MetodosPago}" DisplayMemberPath="Texto"
                                  SelectedItem="{Binding MetodoSeleccionado, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Método de pago" />
                        <Button Grid.Column="1" Content="{x:Static controls:Iconos.Limpiar}" Margin="6,0,0,0"
                                Style="{StaticResource LineaBotonQuitarStyle}" ToolTip="Quitar este pago"
                                Command="{Binding Datos.QuitarPagoCommand, Source={StaticResource Puente}}"
                                CommandParameter="{Binding}" />
                      </Grid>

                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding MonedaTexto, StringFormat='Monto ({0})'}" Margin="0,0,0,2"
                                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                          <TextBox Style="{StaticResource FormTextBoxStyle}" TextAlignment="Right"
                                   Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Referencia" Margin="0,0,0,2"
                                     FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
                          <TextBox Style="{StaticResource FormTextBoxStyle}"
                                   ToolTip="N° de operación, últimos dígitos de la tarjeta…"
                                   Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="{Binding EquivalenteTexto}" FontSize="{StaticResource FsCaption}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Agregar pago" Margin="0" HorizontalAlignment="Stretch"
                      Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AgregarPagoCommand}" />
              <Button Grid.Column="2" Content="Cobrar el resto" Margin="0" HorizontalAlignment="Stretch"
                      Style="{StaticResource SecondaryButtonStyle}"
                      ToolTip="Pone en el último pago lo que falta por cobrar"
                      Command="{Binding CobrarRestoCommand}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
