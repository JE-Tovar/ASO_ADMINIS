<UserControl x:Class="ASO_ADMINIS.Desktop.Views.VentaEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="900">

  <UserControl.Resources>
    <!-- Las columnas del DataGrid no heredan DataContext; ver Controls/PuenteDeDatos.cs -->
    <controls:PuenteDeDatos x:Key="Puente" Datos="{Binding}" />
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Text="{Binding EmisorTexto}" FontSize="{StaticResource FsCaption}"
               Foreground="{DynamicResource TextMutedBrush}" />
    <TextBlock Text="{Binding TasaTexto}" FontSize="{StaticResource FsCaption}"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />

    <!-- Cliente -->
    <TextBlock Text="Cliente" Style="{StaticResource CardTitleStyle}" Margin="0,16,0,4" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1.3*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <controls:FormField Grid.Column="0" Etiqueta="Del padrón" Ayuda="O escriba los datos a la derecha.">
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding Clientes}" DisplayMemberPath="Nombre"
                  SelectedItem="{Binding ClienteSeleccionado}" />
      </controls:FormField>

      <controls:FormField Grid.Column="2" Etiqueta="RIF o C.I." Ayuda="{Binding ClienteRifAyuda}">
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding ClienteRif, UpdateSourceTrigger=PropertyChanged}" />
      </controls:FormField>

      <controls:FormField Grid.Column="4" Etiqueta="Nombre o razón social">
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding ClienteNombre, UpdateSourceTrigger=PropertyChanged}" />
      </controls:FormField>
    </Grid>

    <controls:FormField Etiqueta="Dirección fiscal" Ayuda="Obligatoria si el cliente tiene RIF (la necesita para el crédito fiscal).">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding ClienteDireccion, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <!-- Renglones -->
    <TextBlock Text="Artículos" Style="{StaticResource CardTitleStyle}" Margin="0,16,0,8" />
    <Border Style="{StaticResource SectionCardStyle}" Padding="0">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding Lineas}"
                IsReadOnly="True" MaxHeight="230"
                HeadersVisibility="Column" CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Artículo" Width="34*" MinWidth="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                          ItemsSource="{Binding Articulos}" DisplayMemberPath="Etiqueta"
                          SelectedItem="{Binding ArticuloSeleccionado, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Presentación" Width="14*" MinWidth="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                          ItemsSource="{Binding Presentaciones}" DisplayMemberPath="Nombre"
                          SelectedItem="{Binding PresentacionSeleccionada, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding PresentacionSeleccionada.Texto}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <controls:ColumnaNumero Header="Existencia" Binding="{Binding ExistenciaTexto}" Width="11*" MinWidth="80" />

          <DataGridTemplateColumn Header="Cantidad" Width="10*" MinWidth="76">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox TextAlignment="Right" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}">
                  <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource LineaTextBoxStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SePasa}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                          <Setter Property="ToolTip" Value="No hay tanta existencia de este artículo." />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Precio US$" Width="10*" MinWidth="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Style="{StaticResource LineaTextBoxStyle}" TextAlignment="Right"
                         Text="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <controls:ColumnaTexto Header="IVA" Binding="{Binding AlicuotaTexto}" Width="5*" MinWidth="40" />
          <controls:ColumnaNumero Header="Monto Bs" Binding="{Binding MontoTexto}" Width="12*" MinWidth="90" />

          <DataGridTemplateColumn Width="48">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{x:Static controls:Iconos.Limpiar}"
                        Style="{StaticResource LineaBotonQuitarStyle}" ToolTip="Quitar este artículo"
                        Command="{Binding Datos.QuitarLineaCommand, Source={StaticResource Puente}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Button Content="Agregar artículo" Margin="0,8,0,0" HorizontalAlignment="Left"
            Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AgregarLineaCommand}" />

    <!-- Pagos y desglose, lado a lado -->
    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Pagos" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />
        <Border Style="{StaticResource SectionCardStyle}" Padding="0">
          <DataGrid Style="{StaticResource DataGridStyle}"
                    ItemsSource="{Binding Pagos}"
                    IsReadOnly="True" MaxHeight="170"
                    HeadersVisibility="Column" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Método" Width="26*" MinWidth="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox Style="{StaticResource LineaComboBoxStyle}"
                              ItemsSource="{Binding MetodosPago}" DisplayMemberPath="Texto"
                              SelectedItem="{Binding MetodoSeleccionado, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Monto (Bs o US$)" Width="18*" MinWidth="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBox Style="{StaticResource LineaTextBoxStyle}" TextAlignment="Right"
                             ToolTip="{Binding MonedaTexto}"
                             Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <controls:ColumnaNumero Header="Equivale" Binding="{Binding EquivalenteTexto}" Width="26*" MinWidth="130" />
              <DataGridTemplateColumn Header="Referencia" Width="16*" MinWidth="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBox Style="{StaticResource LineaTextBoxStyle}"
                             Text="{Binding Referencia, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="48">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="{x:Static controls:Iconos.Limpiar}"
                            Style="{StaticResource LineaBotonQuitarStyle}" ToolTip="Quitar este pago"
                            Command="{Binding Datos.QuitarPagoCommand, Source={StaticResource Puente}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Agregar pago" Margin="0" Style="{StaticResource SecondaryButtonStyle}"
                  Command="{Binding AgregarPagoCommand}" />
          <Button Content="Cobrar el resto" Style="{StaticResource SecondaryButtonStyle}"
                  ToolTip="Pone en el último pago lo que falta por cobrar"
                  Command="{Binding CobrarRestoCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- Desglose fiscal -->
      <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Desglose" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />

          <DockPanel Visibility="{Binding HayExento, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Exento (E)" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding ExentoTexto}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Text="Base general (G)" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding BaseGeneralTexto}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
          </DockPanel>
          <TextBlock Text="{Binding IvaGeneralTexto}" HorizontalAlignment="Right" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <StackPanel Visibility="{Binding HayReducida, Converter={StaticResource BoolToVis}}">
            <DockPanel>
              <TextBlock Text="Base reducida (R)" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding BaseReducidaTexto}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>
            <TextBlock Text="{Binding IvaReducidaTexto}" HorizontalAlignment="Right" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <StackPanel Visibility="{Binding HayAdicional, Converter={StaticResource BoolToVis}}">
            <DockPanel>
              <TextBlock Text="Base adicional (A)" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding BaseAdicionalTexto}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
            </DockPanel>
            <TextBlock Text="{Binding IvaAdicionalTexto}" HorizontalAlignment="Right" FontSize="{StaticResource FsCaption}"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <TextBlock Text="{Binding IgtfTexto}" HorizontalAlignment="Right" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Visibility="{Binding HayIgtf, Converter={StaticResource BoolToVis}}" />

          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8" />
          <DockPanel>
            <TextBlock Text="Total" FontWeight="{StaticResource FwBold}" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding TotalTexto}" HorizontalAlignment="Right" Style="{StaticResource FormValorCalculadoStyle}" />
          </DockPanel>
          <TextBlock Text="{Binding TotalUsdTexto}" HorizontalAlignment="Right" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Pagado" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding PagadoTexto}" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}" />
          </DockPanel>
          <TextBlock Text="{Binding PendienteTexto}" HorizontalAlignment="Right" FontWeight="{StaticResource FwBold}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
