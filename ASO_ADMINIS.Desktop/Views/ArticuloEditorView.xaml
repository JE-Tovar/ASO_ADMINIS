<UserControl x:Class="ASO_ADMINIS.Desktop.Views.ArticuloEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="460">

  <StackPanel>
    <controls:FormField Etiqueta="Código"
                        Ayuda="Si lo dejas vacío se genera uno automáticamente al guardar.">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0" Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" />

        <Button Grid.Column="2" Content="Generar" Style="{StaticResource SecondaryButtonStyle}"
                Margin="0" Command="{Binding GenerarCodigoCommand}" />
      </Grid>
    </controls:FormField>

    <controls:FormField Etiqueta="Descripción"
                        Ayuda="Clara y detallada: es lo que se imprime en la factura (p. ej. &quot;Pintura caucho blanco satinado 1 gal&quot;).">
      <TextBox Style="{StaticResource FormTextBoxStyle}" MaxLength="200"
               Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Categoría">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Agrupación libre: Calzado, Pinturas, Ferretería…" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Unidad">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Unidades}"
                    SelectedItem="{Binding UnidadSeleccionada}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Mínimo" Ayuda="Cero significa no vigilar.">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Minimo, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Ubicación">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Pasillo, estante o zona del almacén" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <controls:FormField Grid.Column="0" Etiqueta="Precio de venta sin IVA (US$)"
                          Ayuda="Es el precio con que se factura: en Ventas no se puede cambiar.">
        <StackPanel>
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="{Binding PrecioVentaBsTexto}" FontSize="{StaticResource FsCaption}"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>
      </controls:FormField>

      <controls:FormField Grid.Column="2" Etiqueta="Alícuota de IVA"
                          Ayuda="El porcentaje de cada alícuota se fija en Administración · Organización.">
        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                  ItemsSource="{Binding OpcionesAlicuota}"
                  DisplayMemberPath="Texto" SelectedValuePath="Valor"
                  SelectedValue="{Binding AlicuotaSeleccionada}" />
      </controls:FormField>
    </Grid>

    <!-- Solo a granel (kg, L, m): el número del producto en la balanza que imprime la etiqueta. -->
    <controls:FormField Etiqueta="Código en la balanza (opcional)"
                        Ayuda="El número de producto (PLU) que tiene en la balanza. Al escanear su etiqueta en la factura se agrega con el peso exacto."
                        Visibility="{Binding EsGranel, Converter={StaticResource BoolToVis}}">
      <TextBox Style="{StaticResource FormTextBoxStyle}" MaxLength="13"
               Text="{Binding CodigoBalanza, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <controls:FormField Etiqueta="Notas">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <CheckBox Content="Activo" Margin="0,16,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding Activo}" />

    <TextBlock Text="Un artículo inactivo se conserva en el historial, pero no se ofrece al registrar entradas ni salidas. La existencia no se escribe aquí: sale de lo que entra y lo que sale del almacén."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
