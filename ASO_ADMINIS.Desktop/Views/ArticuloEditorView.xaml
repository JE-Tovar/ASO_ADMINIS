<UserControl x:Class="ASO_ADMINIS.Desktop.Views.ArticuloEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="460">

  <UserControl.Resources>
    <!-- Las columnas del DataGrid no heredan DataContext; ver Controls/PuenteDeDatos.cs -->
    <controls:PuenteDeDatos x:Key="Puente" Datos="{Binding}" />
  </UserControl.Resources>

  <StackPanel>
    <controls:FormField Etiqueta="Código"
                        Ayuda="Si lo dejas vacío se genera uno automáticamente al guardar.">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0" Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" />

        <Button Grid.Column="2" Content="Generar" Style="{StaticResource SecondaryButtonStyle}"
                Margin="0" Command="{Binding GenerarCodigoCommand}" />
      </Grid>
    </controls:FormField>

    <controls:FormField Etiqueta="Nombre del artículo">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Categoría">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Agrupación libre: Calzado, Pinturas, Ferretería…" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Unidad">
          <ComboBox Style="{StaticResource FormComboBoxStyle}"
                    ItemsSource="{Binding Unidades}"
                    SelectedItem="{Binding UnidadSeleccionada}" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <controls:FormField Etiqueta="Mínimo" Ayuda="Cero significa no vigilar.">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Minimo, UpdateSourceTrigger=PropertyChanged}" />
        </controls:FormField>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <controls:FormField Etiqueta="Ubicación">
          <TextBox Style="{StaticResource FormTextBoxStyle}"
                   Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Pasillo, estante o zona del almacén" />
        </controls:FormField>
      </StackPanel>
    </Grid>

    <controls:FormField Etiqueta="Precio de venta (US$)"
                        Ayuda="Referencia: Ventas lo propone al elegir el artículo, pero se puede cambiar en cada venta.">
      <StackPanel>
        <TextBox Style="{StaticResource FormTextBoxStyle}"
                 Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding PrecioVentaBsTexto}" FontSize="{StaticResource FsCaption}"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
    </controls:FormField>

    <!-- Presentaciones: medidas propias del rubro, sin alargar la lista de unidades. -->
    <TextBlock Text="Presentaciones" Style="{StaticResource CardTitleStyle}" Margin="0,16,0,4" />
    <TextBlock Text="Otras medidas en que se compra o se vende, p. ej. Galón = 3,785 litros. La existencia se sigue contando en la unidad base. Déjalo vacío si el artículo solo se maneja en su unidad; el precio vacío se calcula con el precio base."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />

    <Border Style="{StaticResource SectionCardStyle}" Padding="0">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding Presentaciones}"
                IsReadOnly="True"
                MaxHeight="180"
                HeadersVisibility="Column"
                CanUserSortColumns="False">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Nombre" Width="30*" MinWidth="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Style="{StaticResource LineaTextBoxStyle}"
                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="{Binding Datos.EncabezadoFactor, Source={StaticResource Puente}}"
                                  Width="20*" MinWidth="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Style="{StaticResource LineaTextBoxStyle}" TextAlignment="Right"
                         Text="{Binding Factor, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Precio US$ (opcional)" Width="22*" MinWidth="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Style="{StaticResource LineaTextBoxStyle}" TextAlignment="Right"
                         Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Width="56">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{x:Static controls:Iconos.Limpiar}"
                        Style="{StaticResource LineaBotonQuitarStyle}"
                        ToolTip="Quitar esta presentación"
                        Command="{Binding Datos.QuitarPresentacionCommand, Source={StaticResource Puente}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Button Content="Agregar presentación" HorizontalAlignment="Left" Margin="0,8,0,0"
            Style="{StaticResource SecondaryButtonStyle}"
            Command="{Binding AgregarPresentacionCommand}" />

    <controls:FormField Etiqueta="Notas">
      <TextBox Style="{StaticResource FormTextBoxStyle}"
               AcceptsReturn="True" MinLines="2" TextWrapping="Wrap"
               VerticalContentAlignment="Top"
               Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
    </controls:FormField>

    <CheckBox Content="Activo" Margin="0,16,0,0" Cursor="Hand"
              Foreground="{DynamicResource TextPrimaryBrush}"
              IsChecked="{Binding Activo}" />

    <TextBlock Text="Un artículo inactivo se conserva en el historial, pero no se ofrece al registrar entradas ni salidas. La existencia no se escribe aquí: sale de lo que entra y lo que sale del almacén."
               FontSize="{StaticResource FsCaption}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
