<UserControl x:Class="ASO_ADMINIS.Desktop.Views.EntradaDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1000">

  <UserControl.Resources>
    <!-- Las columnas del DataGrid no heredan DataContext; ver Controls/PuenteDeDatos.cs -->
    <controls:PuenteDeDatos x:Key="Puente" Datos="{Binding}" />
  </UserControl.Resources>

  <!-- Ficha de solo lectura de una entrada (doble clic en Inventario · Entradas). Misma
       distribución que su editor: cabecera arriba, renglones con el resto del alto. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal">
        <Border DataContext="{Binding Documento}" Style="{StaticResource ChipEstadoEntradaStyle}"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding EstadoTexto}" FontSize="{StaticResource FsCaption}" />
        </Border>
        <TextBlock Text="{Binding Documento.TipoTexto}" Margin="12,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>

      <UniformGrid Columns="4" Margin="0,4,0,0">
        <controls:Dato Etiqueta="Fecha" Valor="{Binding Documento.FechaTexto}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Origen" Valor="{Binding Documento.OrigenTexto}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Nº de factura o recibo" Valor="{Binding Documento.NumeroDocumento}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Vencimiento del pago" Valor="{Binding VencimientoTexto}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Comprado por" Valor="{Binding Documento.CompradoPor}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Cuenta por pagar" Valor="{Binding CuentaPorPagarTexto}" Margin="0,0,16,0" />
        <controls:Dato Etiqueta="Registrada por" Valor="{Binding Documento.CreadoPorNombre}" Margin="0,0,16,0" />
      </UniformGrid>

      <TextBlock Text="Artículos que entraron" Style="{StaticResource CardTitleStyle}" Margin="0,20,0,8" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Padding="0" MinHeight="140">
      <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Documento.Lineas}"
                IsReadOnly="True" VerticalAlignment="Top" HeadersVisibility="Column">
        <DataGrid.Columns>
          <controls:ColumnaTexto Header="Código" Binding="{Binding ArticuloCodigo}" Width="12*" MinWidth="90" />
          <controls:ColumnaTexto Header="Descripción" Binding="{Binding ArticuloNombre}" Width="30*" MinWidth="180" />
          <controls:ColumnaNumero Header="Cantidad" Binding="{Binding CantidadTexto}" Width="14*" MinWidth="100" />
          <controls:ColumnaNumero Header="Precio" Binding="{Binding PrecioUnitarioTexto}" Width="12*" MinWidth="90"
                                  Visibility="{Binding Datos.MuestraPrecios, Source={StaticResource Puente},
                                                       Converter={StaticResource BoolToVis}}" />
          <controls:ColumnaNumero Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="12*" MinWidth="90"
                                  Visibility="{Binding Datos.MuestraPrecios, Source={StaticResource Puente},
                                                       Converter={StaticResource BoolToVis}}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <StackPanel Grid.Row="2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                  Visibility="{Binding MuestraPrecios, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Total" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding Documento.TotalTexto}" Style="{StaticResource FormValorCalculadoStyle}" />
      </StackPanel>

      <controls:Dato Etiqueta="Observaciones" Valor="{Binding Documento.Observaciones}" />
      <controls:Dato Etiqueta="Anulación" Valor="{Binding AnulacionTexto}" />
    </StackPanel>
  </Grid>
</UserControl>
