<UserControl x:Class="ASO_ADMINIS.Desktop.Views.ReporteGastosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ASO_ADMINIS.Desktop.Controls"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">

  <Grid Style="{StaticResource PantallaPlenaStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader Grid.Row="0"
                         Titulo="{Binding Submodulo.Nombre}"
                         Descripcion="{Binding Submodulo.Descripcion}" />

    <Border Grid.Row="1" Style="{StaticResource ToolbarStyle}" Margin="0,16,0,0">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,8,0"
                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
        <DatePicker Width="130" VerticalAlignment="Center" Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding Desde}" />
        <TextBlock Text="hasta" VerticalAlignment="Center" Margin="8,0,8,0"
                   FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}" />
        <DatePicker Width="130" VerticalAlignment="Center" Style="{StaticResource FormDatePickerStyle}"
                    SelectedDate="{Binding Hasta}" />

        <controls:FiltroDropdown Style="{StaticResource FiltroDropdownStyle}" SelectedIndex="0"
                                 Margin="16,0,0,0" VerticalAlignment="Center"
                                 Command="{Binding CambiarFiltroCommand}">
          <ComboBoxItem Content="Todos" />
          <ComboBoxItem Content="Proveedores" />
          <ComboBoxItem Content="Gastos varios" />
        </controls:FiltroDropdown>

        <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Total Bs" VerticalAlignment="Center" Margin="0,0,8,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding TotalTexto}" Style="{StaticResource FormValorCalculadoStyle}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Proveedores" VerticalAlignment="Center" Margin="0,0,8,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding ProveedoresTexto}" Style="{StaticResource FormValorCalculadoStyle}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{Binding CantidadVariosTexto, StringFormat='Gastos varios ({0})'}" />
          <TextBlock Text="{Binding VariosTexto}" Style="{StaticResource FormValorCalculadoStyle}" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" MinWidth="260">
        <oxy:PlotView Model="{Binding GraficoPorMes}" Height="300" Background="Transparent" />
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" MinWidth="260">
        <oxy:PlotView Model="{Binding GraficoPorCategoria}" Height="300" Background="Transparent" />
      </Border>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}" Padding="0" Margin="0,16,0,0">
      <Grid>
        <DataGrid x:Name="TablaGastos" Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding Items}" IsReadOnly="True">
          <DataGrid.Columns>
            <controls:ColumnaTexto Header="Fecha" Binding="{Binding FechaTexto}" Width="9*" MinWidth="80" />
            <controls:ColumnaTexto Header="Origen" Binding="{Binding OrigenTexto}" Width="9*" MinWidth="86" />
            <controls:ColumnaTexto Header="Categoría" Binding="{Binding Categoria}" Width="14*" MinWidth="110" />
            <controls:ColumnaTexto Header="Beneficiario" Binding="{Binding Beneficiario}" Width="15*" MinWidth="110" />
            <controls:ColumnaTexto Header="Documento" Binding="{Binding Documento}" Width="10*" MinWidth="86" />
            <controls:ColumnaTexto Header="Concepto" Binding="{Binding Concepto}" Width="19*" MinWidth="130" />
            <controls:ColumnaNumero Header="Monto" Binding="{Binding MontoTexto}" Width="11*" MinWidth="90" />
            <controls:ColumnaNumero Header="Bs" Binding="{Binding MontoBsTexto}" Width="11*" MinWidth="90" />
          </DataGrid.Columns>
        </DataGrid>

        <controls:EmptyState Icono="{x:Static controls:Iconos.Reportes}"
                             Titulo="Sin gastos en este período"
                             Detalle="Ajusta el rango de fechas, registra el pago de una factura en Finanzas · Cuentas por Pagar o un gasto en Finanzas · Gastos varios."
                             Visibility="{Binding HasItems, ElementName=TablaGastos, Converter={StaticResource SinItemsAVis}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
