<UserControl x:Class="ASO_ADMINIS.Desktop.Controls.TortaConLeyenda"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             x:Name="Raiz"
             d:DesignHeight="300" d:DesignWidth="420">

  <!--
    Torta de Reportes con su leyenda al lado (Grafico = GraficoTorta, ver ViewModels/Graficos.cs).
    La leyenda es WPF y no de OxyPlot porque la PieSeries no pinta sus porciones en Legends: cada
    fila repite el color de su porción, con el nombre, el % y el monto.
  -->
  <Grid DataContext="{Binding Grafico, ElementName=Raiz}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{Binding Titulo}" FontWeight="{StaticResource FwBold}"
               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"
               Margin="0,0,0,8" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MaxWidth="220" MinWidth="120" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="6*" />
      </Grid.ColumnDefinitions>

      <oxy:PlotView Grid.Column="0" Model="{Binding Modelo}" Background="Transparent" />

      <ScrollViewer Grid.Column="2" VerticalAlignment="Center"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Porciones}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Rectangle Grid.Column="0" Grid.Row="0" Width="10" Height="10" RadiusX="2" RadiusY="2"
                           Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,8,0" />

                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Nombre}" ToolTip="{Binding Nombre}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding PorcentajeTexto}"
                           FontWeight="{StaticResource FwBold}" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding MontoTexto}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{StaticResource FsCaption}"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="Sin datos en este período"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource TextMutedBrush}"
                 Visibility="{Binding SinDatos, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </Grid>
</UserControl>
