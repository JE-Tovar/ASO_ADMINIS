<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ASO_ADMINIS.Desktop</RootNamespace>
    <AssemblyName>ASO_ADMINIS.Desktop</AssemblyName>
    <ApplicationTitle>ASO Adminis</ApplicationTitle>
    <Product>ASO Adminis</Product>
    <Company>ASO Adminis</Company>
    <Description>Aplicación de gestión — venta de artículos</Description>
    <Version>0.2.0</Version>
    <!-- Main propio (Program.cs) en vez del que genera App.xaml: Velopack tiene que correr antes
         que nada de WPF, porque al instalar, actualizar y desinstalar lanza el .exe con
         argumentos suyos y espera que salga sin abrir ventanas. -->
    <StartupObject>ASO_ADMINIS.Desktop.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.28" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.28">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />

    <!-- Reportes · Ventas y Gastos: gráficos de barras y torta. Primera librería de terceros
         del proyecto fuera de EF Core - pura administrada, sin binarios nativos. -->
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <!-- Instalador + actualizaciones automaticas desde GitHub Releases (Program.cs,
         Services/Actualizaciones.cs). Ver README "Publicar una version". -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- La fuente de iconos viaja con el proyecto. Antes se usaba Segoe MDL2 Assets, que solo
       existe en Windows 10/11 y no se puede fijar a una version. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Phosphor.ttf" />
  </ItemGroup>

  <!-- Tipografia de la aplicacion (Satoshi, empotrada igual que Phosphor): asi no depende de que
       este instalada en la maquina. Los tres cortes comparten nombre de familia, asi que WPF
       elige el que toca por FontWeight y AppFont sigue siendo una sola clave. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Satoshi-Regular.ttf" />
    <Resource Include="Assets\Fonts\Satoshi-Medium.ttf" />
    <Resource Include="Assets\Fonts\Satoshi-Bold.ttf" />
  </ItemGroup>

  <!-- Logo (caja registradora): el .ico lo genera Assets/Logo/generar_icono.py a partir de la
       misma geometria que LogoCajaGeometry (Styles/Componentes.xaml). ApplicationIcon es el del
       .exe; el Resource es el que usan los Icon= de cada Window (barra de tareas, Alt+Tab). -->
  <PropertyGroup>
    <ApplicationIcon>Assets\Logo\aso-adminis.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Logo\aso-adminis.ico" />
    <None Remove="Assets\Logo\generar_icono.py" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Se copia para dotnet run / F5, pero NUNCA al publicar: el instalador acaba en GitHub
         Releases de un repo publico y este archivo lleva la cadena de conexion de la maquina.
         Instalada, la app lo busca en %LocalAppData%\ASO Adminis (ver AppConfig). -->
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
