<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ASO_ADMINIS.Desktop.ViewModels"
                    xmlns:views="clr-namespace:ASO_ADMINIS.Desktop.Views">

  <!-- Cada editor CRUD aporta un UserControl de formulario; CrudEditorWindow los aloja
       a través de DataTemplate implícitos declarados aquí, sin conocer la entidad concreta.
       Se irán registrando a medida que cada submódulo tenga su editor. -->

  <!-- Editor genérico de motivo: lo reutilizan todas las anulaciones -->
  <DataTemplate DataType="{x:Type vm:MotivoEditorViewModel}">
    <views:MotivoEditorView />
  </DataTemplate>

  <!-- Ventas -->

  <DataTemplate DataType="{x:Type vm:VentaEditorViewModel}">
    <views:VentaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ClienteEditorViewModel}">
    <views:ClienteEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:NotaFiscalEditorViewModel}">
    <views:NotaFiscalEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ContingenciaEditorViewModel}">
    <views:ContingenciaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:RetencionEditorViewModel}">
    <views:RetencionEditorView />
  </DataTemplate>

  <!-- Finanzas · Cuentas por Pagar y Banco -->

  <DataTemplate DataType="{x:Type vm:ProveedorEditorViewModel}">
    <views:ProveedorEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:GastoVarioEditorViewModel}">
    <views:GastoVarioEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FacturaProveedorEditorViewModel}">
    <views:FacturaProveedorEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:AsientoBancoEditorViewModel}">
    <views:AsientoBancoEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:MovimientoBancoEditorViewModel}">
    <views:MovimientoBancoEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:CuentaBancariaEditorViewModel}">
    <views:CuentaBancariaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:TransferenciaEditorViewModel}">
    <views:TransferenciaEditorView />
  </DataTemplate>

  <!-- Inventario -->

  <DataTemplate DataType="{x:Type vm:ServicioEditorViewModel}">
    <views:ServicioEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ArticuloEditorViewModel}">
    <views:ArticuloEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:EntradaEditorViewModel}">
    <views:EntradaEditorView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SalidaEditorViewModel}">
    <views:SalidaEditorView />
  </DataTemplate>

  <!-- Armazón -->

  <DataTemplate DataType="{x:Type vm:UsuarioEditorViewModel}">
    <views:UsuarioEditorView />
  </DataTemplate>

</ResourceDictionary>
